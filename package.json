{
  "name": "@robosystems/core",
  "version": "0.20.0",
  "description": "Shared RoboSystems frontend core library (auth, contexts, task monitoring, UI components) for the RoboSystems Next.js apps",
  "license": "MIT",
  "private": false,
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RoboFinSystems/robosystems-core.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "feature:create": "./bin/create-feature.sh",
    "release:create": "./bin/create-release.sh",
    "clean": "rm -rf dist *.tgz",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/prepare-package.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "pack:local": "npm run build && npm pack ./dist",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run --silent",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest watch --silent",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage --silent",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:all": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "//scripts": "The vitest scripts turn off Node's Web Storage: Node 25+ defines `localStorage` on globalThis, undefined until a --localstorage-file is given, and vitest's jsdom environment does not replace a global the runtime already owns, so tests would read undefined. Accepted on Node 22, 24 and 26.",
  "peerDependencies": {
    "@robosystems/client": ">=2.34 <3",
    "next": ">=15 <17",
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "react-icons": ">=4 <6"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "github-slugger": "^2.0.0",
    "react-markdown": "^10",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@next/eslint-plugin-next": "^16.2.10",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "prettier": "^3",
    "prettier-plugin-organize-imports": "^4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prop-types": "^15.8.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8",
    "vite": "^8.2.2",
    "vitest": "^4.1.12"
  }
}
